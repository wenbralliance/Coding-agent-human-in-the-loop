# ========== LLM ==========
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF=1.0
LLM_TIMEOUT=60

# ========== Embedding ==========
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
EMBEDDING_MAX_RETRIES=3
EMBEDDING_TIMEOUT=30

# ========== Database ==========
DB_PATH=data/coding_agent.db

# ========== Workspace ==========
WORKSPACE_PATH=workspace

# ========== Runtime ==========
SANDBOX_MODE=subprocess
SANDBOX_TIMEOUT=10
GUI_STARTUP_GRACE=2.0
TOOL_OUTPUT_MAX_CHARS=6000
TOOL_MAX_RETRIES=2
TOOL_TIMEOUT=10
MAX_TOOL_ROUNDS=8
MAX_TOTAL_RETRIES=10
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN=60

# ========== Memory ==========
MEMORY_CONFIDENCE_THRESHOLD=0.6
MEMORY_TOP_K=5
MEMORY_DECAY_EVENT=3
MEMORY_DECAY_PREFERENCE=180

# ========== Context ==========
MAX_HISTORY_MESSAGES=10
COMPRESS_THRESHOLD=0.6
