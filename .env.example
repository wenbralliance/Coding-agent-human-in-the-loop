# ========== LLM ==========
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF=1.0
LLM_TIMEOUT=60
LLM_FALLBACK_MODEL=
LLM_SESSION_TOKEN_BUDGET=200000
LLM_DAILY_COST_BUDGET_USD=5.0
LLM_BUDGET_DEGRADE_RATIO=0.8
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
LLM_CACHED_INPUT_COST_PER_MILLION=0

# ========== LangSmith ==========
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=coding-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ========== Embedding ==========
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIM=1024
EMBEDDING_MAX_RETRIES=3
EMBEDDING_TIMEOUT=30

# ========== Database ==========
DB_PATH=data/coding_agent.db

# ========== Workspace ==========
WORKSPACE_PATH=workspace

# ========== Runtime ==========
SANDBOX_MODE=subprocess
SANDBOX_TIMEOUT=10
GUI_STARTUP_GRACE=2.0
TOOL_OUTPUT_MAX_CHARS=6000
TOOL_MAX_RETRIES=2
# 留空时自动检测 PATH 或桌面版内置 Git Bash。
BASH_EXECUTABLE=
BASH_TIMEOUT=60
BASH_OUTPUT_MAX_BYTES=32000
BASH_SESSION_IDLE_SECONDS=600
MAX_BASH_SESSIONS=4
MAX_PARALLEL_TOOLS=4
MAX_CONCURRENT_TASKS=2
TASK_QUEUE_TIMEOUT=10
LOOP_REPEAT_THRESHOLD=3
MAX_TOOL_ROUNDS=12
MAX_READ_FILES=50
MAX_READ_CHARS_PER_CALL=100000
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN=60
ALERT_TOOL_FAILURE_RATE=0.2
ALERT_TOOL_WINDOW_SIZE=20
ALERT_APPROVAL_WAIT_SECONDS=600
WORKFLOW_VERSION=v1.2.0-guarded
CANARY_VERSION=
CANARY_PERCENT=0

# ========== Memory ==========
MEMORY_CONFIDENCE_THRESHOLD=0.6
MEMORY_TOP_K=5
MEMORY_DECAY_EVENT=3
MEMORY_DECAY_PREFERENCE=180

# ========== Context ==========
MAX_HISTORY_MESSAGES=10
COMPRESS_THRESHOLD=0.6
